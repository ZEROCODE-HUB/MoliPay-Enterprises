# URL del backend de pagos (molipay-back).
# El checkout tokeniza la tarjeta con el SDK oficial decidir.js usando la API Key
# publica que este backend expone en GET /api/payway/config, y despues envia solo
# el token (mas el BIN, que Payway exige en POST /payments) a este backend.
# El monto y el estado final los decide el backend, no el navegador.
# Debe coincidir con uno de los origenes de CORS_ALLOWED_ORIGINS en molipay-back.
VITE_PAYMENTS_API_URL=http://localhost:8787

# Prellena los datos de tarjeta de prueba de Payway en el checkout.
#
# Solo tiene efecto si ademas es un build de DESARROLLO: el gate exige DEV y este
# flag, de modo que un build de produccion nunca los carga ni aunque este valor
# quede puesto por error.
#
# La tarjeta es una Visa credito de sandbox validada por soporte de Payway.
# OJO: las credenciales de Payway que uses tienen que ser de SANDBOX. Con claves
# de produccion, esta tarjeta no sirve y ademas el resto del flujo cobra de verdad.
VITE_PAYWAY_TEST_CARD=true

# Estos secretos son SOLO para los edge functions (se setean con `supabase secrets set`, no en .env).
# SUPABASE_URL=https://doqghevvrfufsynwkzxj.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=re_xxx
# APP_URL=https://tu-dominio.com   (o http://localhost:5173 en dev; debe coincidir con el link del email)
# RESEND_FROM=Molipay <altas@tudominio.com>   (debe usar el dominio verificado en Resend)

